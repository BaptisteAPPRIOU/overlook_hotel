# Copy this file to .env.prod on the deployment host, or provide the same
# variables through your orchestrator/secrets manager.
# Do not commit .env.prod.

DOCKER_IMAGE=overlook-hotel:prod
SITE_DOMAIN=overlookhotel.fr

DOCKER_POSTGRES_DB=overlookhoteldb
DOCKER_POSTGRES_USER=overlook_app
DOCKER_POSTGRES_PASSWORD=replace_with_database_password

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/overlookhoteldb
SPRING_DATASOURCE_USERNAME=overlook_app
SPRING_DATASOURCE_PASSWORD=replace_with_database_password

SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

SPRING_SECURITY_USER_NAME=admin
SPRING_SECURITY_USER_PASSWORD=replace_with_admin_password

# Minimum 32 characters for HS256.
APP_JWT_SECRET=replace_with_a_secret_key_of_at_least_32_characters
APP_JWT_EXPIRATION_MS=86400000
APP_SEED_ENABLED=false
