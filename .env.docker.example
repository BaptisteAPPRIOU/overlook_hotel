# Copy this file to .env.docker for local Docker Compose runs.
# Do not commit .env.docker.

DOCKER_POSTGRES_DB=overlookhoteldb
DOCKER_POSTGRES_USER=postgres
DOCKER_POSTGRES_PASSWORD=postgres
DOCKER_POSTGRES_PORT=5432

DOCKER_REDIS_PORT=6379

DOCKER_SECURITY_USER_NAME=dev
DOCKER_SECURITY_USER_PASSWORD=dev-password

# Minimum 32 characters for HS256.
DOCKER_APP_JWT_SECRET=local_docker_jwt_secret_with_32_chars_min
APP_JWT_EXPIRATION_MS=86400000

# true gives local demo data when the application's seed layer supports it.
APP_SEED_ENABLED=true

APP_PORT=8080
